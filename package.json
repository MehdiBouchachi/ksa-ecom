{
  "name": "saudi-ecom",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20.18" },
  "scripts": {
    "dev": "pnpm --filter @saudi-ecom/web dev",
    "build": "pnpm --filter @saudi-ecom/web build",
    "start": "pnpm --filter @saudi-ecom/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @saudi-ecom/web db:generate",
    "db:migrate": "pnpm --filter @saudi-ecom/web db:migrate",
    "db:seed:demo": "pnpm --filter @saudi-ecom/web db:seed:demo",
    "db:create-admin": "pnpm --filter @saudi-ecom/web db:create-admin"
  }
}
