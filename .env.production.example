# Production / staging settings for docker-compose.prod.yml.
# Copy to .env.production ON THE SERVER ONLY (git-ignored). Never commit real values.
# NOT needed for local runs — `docker compose up` works with zero configuration.
# AUTH_SECRET, CRON_SECRET, the DB password and the first admin password are generated
# automatically on first boot (private Docker volume). Only third-party credentials go here.

DOMAIN=shop.example.com
ADMIN_EMAIL=owner@example.com
ALLOW_INDEXING=false            # true ONLY on the real production domain

# Email (required): verified sending domain (SPF/DKIM)
SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Store <no-reply@example.com>"
STAFF_ALERT_EMAIL=ops@example.com

# Payments — merchant-approved PSP PENDING. Until then checkout refuses (NOT_CONFIGURED).
# Staging only: ALLOW_MOCK_PAYMENTS=1 / ALLOW_MOCK_SHIPPING=1
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
SHIPPING_PROVIDER=aramex-mock

# Media (durable object storage, e.g. Cloudflare R2 — PENDING approval)
MEDIA_PUBLIC_HOST=

# Optional: use an external managed PostgreSQL instead of the bundled container (verify-full TLS).
# DATABASE_URL=postgres://user:pass@host:5432/db
