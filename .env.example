# NOT needed for Docker: `docker compose up -d --build` generates every secret itself.
# Only for running without Docker: copy to apps/web/.env.local (development) or set in the host's environment.
# NEVER commit real values. Nothing here may be prefixed NEXT_PUBLIC_ (all server-only).

# --- App ---
APP_URL=http://localhost:3000            # public origin (https://shop.example.com in production)
ALLOW_INDEXING=false                     # true ONLY on the production domain (staging must stay noindex)

# --- Auth.js ---
AUTH_SECRET=                              # openssl rand -base64 48
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true                      # behind Hostinger's proxy

# --- External managed PostgreSQL (NOT Supabase; NOT hosted on Hostinger Business) ---
DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_SSL=disable                      # local only. Production: verify-full (default when NODE_ENV=production)
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"   # provider CA if not in system store
DATABASE_POOL_MAX=5                       # keep small: single Node process + provider connection limits
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Payments (merchant-approved PSP PENDING) ---
PAYMENT_PROVIDER=mock                     # mock = sandbox simulator (refused in production unless ALLOW_MOCK_PAYMENTS=1 on staging)
PAYMENT_WEBHOOK_SECRET=                   # webhook signing secret from the PSP dashboard
PAYMENT_ABANDON_GRACE_MINUTES=30
# ALLOW_MOCK_PAYMENTS=1                   # staging only

# --- Shipping (Aramex credentials PENDING) ---
SHIPPING_PROVIDER=aramex-mock
# ALLOW_MOCK_SHIPPING=1                   # staging only
# ARAMEX_ACCOUNT_NUMBER= ARAMEX_ACCOUNT_PIN= ARAMEX_ACCOUNT_ENTITY= ARAMEX_ACCOUNT_COUNTRY_CODE=SA ARAMEX_USERNAME= ARAMEX_PASSWORD=

# --- Email (transactional) ---
SMTP_URL=                                 # smtps://user:pass@smtp.example.com:465 (required in production)
MAIL_FROM="Store <no-reply@example.com>"  # verified sending domain (SPF/DKIM)
STAFF_ALERT_EMAIL=ops@example.com

# --- Cron (Hostinger cron → scripts/cron.sh) ---
CRON_SECRET=                              # >= 32 chars: openssl rand -hex 32

# --- Media (durable object storage, e.g. Cloudflare R2 — PENDING approval) ---
MEDIA_PUBLIC_HOST=                        # e.g. media.example.com (enables next/image for that host)

# --- Ops ---
BCRYPT_COST=12
LOG_SILENT=0
